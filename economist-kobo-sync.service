[Unit]
Description=Download the latest Economist and send it to Kobo
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Update the paths below to match your setup
WorkingDirectory=/home/USER/Economist-
ExecStart=/usr/bin/python3 /home/USER/Economist-/sync.py
# Load credentials from the .env file
EnvironmentFile=/home/USER/Economist-/.env
User=USER

[Install]
WantedBy=multi-user.target
