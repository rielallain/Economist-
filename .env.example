# ── Economist subscription ────────────────────────────────────────────────────
ECONOMIST_EMAIL=you@example.com
ECONOMIST_PASSWORD=your_economist_password

# ── Delivery method ───────────────────────────────────────────────────────────
# calibredb  — add to local Calibre library; Calibre-Web syncs to Kobo over WiFi (recommended)
# email      — send EPUB to a "Send to Kobo" address
# dropbox    — copy to a Dropbox folder
# usb        — copy to a mounted Kobo device
DELIVERY_METHOD=calibredb

# ── Calibre-Web (DELIVERY_METHOD=calibredb) ───────────────────────────────────
# Path to your Calibre library — Calibre creates this on first launch
CALIBRE_LIBRARY=~/Calibre Library
# Path to Calibre app binaries on macOS
CALIBRE_BIN=/Applications/calibre.app/Contents/MacOS

# ── Where downloaded EPUBs are saved locally ──────────────────────────────────
DOWNLOAD_DIR=~/Downloads/Economist

# ── Email delivery (DELIVERY_METHOD=email) ────────────────────────────────────
# KOBO_EMAIL=your-kobo-address@send.kobo.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_gmail_app_password

# ── Dropbox delivery (DELIVERY_METHOD=dropbox) ────────────────────────────────
# DROPBOX_PATH=~/Library/CloudStorage/Dropbox/Kobo

# ── USB delivery (DELIVERY_METHOD=usb) ────────────────────────────────────────
# KOBO_MOUNT_PATH=/Volumes/KOBOeReader
