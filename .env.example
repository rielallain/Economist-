# ── Economist subscription ────────────────────────────────────────────────────
ECONOMIST_EMAIL=you@example.com
ECONOMIST_PASSWORD=your_economist_password

# ── Delivery method ───────────────────────────────────────────────────────────
# Choose one: email | dropbox | usb
DELIVERY_METHOD=email

# ── Send to Kobo (DELIVERY_METHOD=email) ─────────────────────────────────────
# 1. Go to https://www.kobo.com/account and enable "Send to Kobo"
# 2. Copy the Kobo email address shown there (looks like abc123@send.kobo.com)
# 3. Add your SMTP_USER address to the approved senders list on that page
KOBO_EMAIL=your-kobo-address@send.kobo.com

# Your outgoing email account (Gmail shown; any SMTP provider works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_password

# ── Dropbox sync (DELIVERY_METHOD=dropbox) ────────────────────────────────────
# 1. On your Kobo: Settings → Account → Connect to Dropbox
# 2. Kobo syncs from the root of the connected Dropbox folder
# DROPBOX_PATH=~/Dropbox/Books

# ── USB / wired (DELIVERY_METHOD=usb) ─────────────────────────────────────────
# Path to the mounted Kobo device
# KOBO_MOUNT_PATH=/media/user/KOBOeReader

# ── Optional ──────────────────────────────────────────────────────────────────
# Local folder where downloaded EPUBs are kept
# DOWNLOAD_DIR=~/Downloads/Economist

# Path to Calibre binaries if not on PATH (e.g. /opt/calibre)
# CALIBRE_BIN=/opt/calibre
