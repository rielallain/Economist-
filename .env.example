# ── Economist subscription ────────────────────────────────────────────────────
ECONOMIST_EMAIL=you@example.com
ECONOMIST_PASSWORD=your_economist_password

# ── Delivery method ───────────────────────────────────────────────────────────
# Choose one: dropbox | email | usb
DELIVERY_METHOD=dropbox

# ── Dropbox sync (DELIVERY_METHOD=dropbox) ────────────────────────────────────
# 1. On your Kobo: Settings → My account → Dropbox → Connect
# 2. Copy any EPUB files into the Dropbox folder below — Kobo will sync them over WiFi
#
# macOS 12.3+: Dropbox lives at ~/Library/CloudStorage/Dropbox
# Older macOS:                   ~/Dropbox
DROPBOX_PATH=~/Library/CloudStorage/Dropbox/Kobo

# ── Send to Kobo via email (DELIVERY_METHOD=email) ────────────────────────────
# Only needed if you prefer email delivery over Dropbox.
# 1. Go to https://www.kobo.com/account and enable "Send to Kobo"
# 2. Copy the Kobo address shown (abc123@send.kobo.com)
# 3. Add your sending address to the approved senders list
# KOBO_EMAIL=your-kobo-address@send.kobo.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_gmail_app_password

# ── USB / wired (DELIVERY_METHOD=usb) ─────────────────────────────────────────
# Path to the mounted Kobo device
# KOBO_MOUNT_PATH=/media/user/KOBOeReader

# ── Optional ──────────────────────────────────────────────────────────────────
# Local folder where downloaded EPUBs are kept
# DOWNLOAD_DIR=~/Downloads/Economist

# Path to Calibre binaries if not on PATH (e.g. /opt/calibre)
# CALIBRE_BIN=/opt/calibre
